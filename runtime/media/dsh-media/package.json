{
  "name": "dsh-media",
  "version": "0.1.0-m0.2",
  "description": "Host-owned image generation for DeepSeek Harness; M0 review candidate",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./config": "./src/config.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js",
    "data/models.json",
    "cordis.patch.yml",
    "README.md",
    "MEDIA-CATALOG-CONTRACT.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.4",
    "image-size": "2.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.4",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.4",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": "0.2.1-rc.4"
  }
}
